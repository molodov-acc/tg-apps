{
  "name": "tg-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w apps/bot run dev",
    "api:dev": "npm -w apps/api run dev",
    "miniapp:dev": "npm -w apps/miniapp run dev",
    "build": "npm -ws run build",
    "start": "npm -w apps/bot run start"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "prisma": "^7.5.0"
  }
}
